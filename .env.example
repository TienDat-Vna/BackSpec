# ==============================================================================
# Microservice Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES. NEVER COMMIT .env TO GIT.
# ==============================================================================

# Application
APP_NAME=my-microservice
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=debug

# Database (PostgreSQL / MySQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=service_db
DB_USER=postgres
DB_PASSWORD=secret_password
DB_READONLY_HOST=localhost
DB_READONLY_PORT=5432
DB_READONLY_USER=readonly_user
DB_READONLY_PASSWORD=readonly_password
DB_READONLY_DATABASE=service_db

# Messaging / Event Broker (Kafka / RabbitMQ / Redis)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=service-consumer-group
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Service-to-Service Auth
JWT_SECRET=replace-with-a-secure-256-bit-secret-key-at-least-32-chars
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
INTERNAL_SERVICE_API_KEY=replace-with-internal-service-token

# Downstream Microservice Endpoints
AUTH_SERVICE_URL=http://localhost:8081
USER_SERVICE_URL=http://localhost:8082
PAYMENT_SERVICE_URL=http://localhost:8083
NOTIFICATION_SERVICE_URL=http://localhost:8084

# MCP Server integration (Optional)
GITHUB_TOKEN=
