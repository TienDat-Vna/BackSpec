{
  "name": "backspec",
  "version": "1.0.0",
  "description": "BackSpec & Specify — Enterprise Spec-Driven Development (SDD) & Multi-Agent Governance Tool for Backend Microservices",
  "main": "lib/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/",
    "lib/",
    "registry/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    ".agentignore",
    ".mcp.json"
  ],
  "bin": {
    "backspec": "./bin/backspec.js",
    "specify": "./bin/backspec.js",
    "speckit": "./bin/backspec.js"
  },
  "scripts": {
    "start": "node bin/backspec.js",
    "backspec": "node bin/backspec.js",
    "specify": "node bin/backspec.js",
    "speckit": "node bin/backspec.js",
    "init": "node bin/backspec.js init",
    "check": "node bin/backspec.js check",
    "doctor": "node bin/backspec.js doctor",
    "spec": "node bin/backspec.js spec",
    "audit": "node bin/backspec.js audit",
    "ingest": "node bin/backspec.js ingest",
    "plan": "node bin/backspec.js plan",
    "tasks": "node bin/backspec.js tasks",
    "clarify": "node bin/backspec.js clarify",
    "checklist": "node bin/backspec.js checklist",
    "analyze": "node bin/backspec.js analyze",
    "implement": "node bin/backspec.js implement",
    "pr": "node bin/backspec.js pr",
    "export": "node bin/backspec.js export",
    "sync": "node bin/backspec.js sync",
    "sync-rules": "node bin/backspec.js sync --rules",
    "sync-skills": "node bin/backspec.js sync --skills",
    "sync-all": "node bin/backspec.js sync",
    "list": "node bin/backspec.js list",
    "status": "node bin/backspec.js status",
    "dashboard": "node bin/backspec.js dashboard",
    "adopt": "node bin/backspec.js adopt",
    "validate": "node bin/backspec.js validate",
    "override": "node bin/backspec.js override",
    "quality": "node bin/backspec.js quality . --strict",
    "test": "node tests/test-skill-system.js && node tests/test-quality-gate.js",
    "prepare": "husky || true"
  },
  "keywords": [
    "backspec",
    "specify",
    "speckit",
    "spec-kit",
    "sdd",
    "spec-driven-development",
    "agent-driven-development",
    "backend-microservices",
    "governance",
    "claude-code",
    "antigravity",
    "copilot",
    "cursor",
    "windsurf"
  ],
  "dependencies": {
    "commander": "^15.0.0",
    "docx": "^9.8.1",
    "mammoth": "^1.13.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10"
  },
  "lint-staged": {
    "*.{java,go,ts,js,py,cs,rs}": [
      "echo 'Running backend linter/formatter on staged files...'"
    ],
    "*.md": [
      "node -e \"console.log('Markdown validated')\""
    ]
  }
}
